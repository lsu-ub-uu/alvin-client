#: .\alvin_info\templates\alvin_info\copyright.html:45
#: .\vocabulary\templates\vocabulary\iiif.html:44
msgid ""
"Nästan allt digitalt material som du hittar i Alvin får användas helt fritt. "
"Var dock uppmärksam på att en del modernare material kan vara "
"upphovsrättsskyddat. Rättighetsmärkningen i varje post talar om vad som "
"gäller."
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:46
msgid "Licensiering av digitala verk i Alvin"
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:48
msgid ""
"Merparten av det digitala materialet i Alvin saknar upphovsrätt och görs "
"tillgängligt enligt"
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:49
msgid ""
"För material med upphovsrätt kan upphovsmannen välja licens för publicering "
"enligt"
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:50
msgid "Material med upphovsrätt som saknar licens publiceras som"
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:52
msgid ""
"Varje deltagande medlem i Alvin ansvarar för korrekt uppmärkning och "
"publicering av eget material."
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:53
msgid "Metadata i Alvin"
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:54
#: .\vocabulary\templates\vocabulary\oai-pmh.html:53
msgid "Metadataposter från Alvin är fritt tillgängliga enligt"
msgstr ""

#: .\alvin_info\templates\alvin_info\copyright.html:54
msgid ""
"Vem som helst kan sedan använda uppgifterna på vilket sätt som helst och för "
"vilket syfte som helst, inklusive kommersiella ändamål."
msgstr ""

